# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Each developer registers their own Spotify and SoundCloud apps (see README → OAuth setup).

# SoundCloud OAuth (live search, library, playback). Register the redirect URI in your SoundCloud app.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Must match the redirect URI in the SoundCloud developer portal exactly (scheme, host, port, path).
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/soundcloud/callback

# Spotify OAuth (live search, library, Web Playback SDK). Register the redirect URI in the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/spotify/callback
# Default scopes (if unset) include user-library-read (Liked Songs) and playlist-read-* for the in-app library browser.
# SPOTIFY_SCOPES=streaming user-modify-playback-state user-read-email user-read-private user-library-read playlist-read-private playlist-read-collaborative

# Server / OAuth redirect base (optional; defaults from request Host header)
# PORT=3000
# HOST=127.0.0.1
# PUBLIC_BASE_URL=http://127.0.0.1:3000

# Split-origin dev: comma-separated origins allowed to call /api (e.g. Live Server on :5500)
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Database (optional)
# SQLITE_PATH=./data/app.db
